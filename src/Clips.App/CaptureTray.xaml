<Window x:Class="Clips.App.CaptureTray" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Capture tray" Width="380" Height="570" MinWidth="320" MinHeight="350" ShowInTaskbar="False" Topmost="True" Opacity="0.98">
 <DockPanel Margin="18">
  <StackPanel DockPanel.Dock="Top"><DockPanel><Border Background="{Binding TrayColor}" Width="10" CornerRadius="5" Margin="0,0,10,0"/><TextBlock Text="{Binding TrayLabel}" FontWeight="SemiBold" FontSize="18" TextWrapping="Wrap"/></DockPanel><TextBlock Text="{Binding TrayState}" Foreground="{DynamicResource Muted}" Margin="0,8,0,14"/><TextBlock Text="Latest five captures" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,12"/><TextBlock Text="{Binding Error}" TextWrapping="Wrap"/></StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
   <DockPanel DataContext="{Binding Feedback}"><Button DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" Visibility="{Binding HasAction,Converter={StaticResource BoolVisibility}}" Padding="8,4"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/></DockPanel>
   <WrapPanel><Button Content="Open notebook" Click="OpenNotebook"/><Button x:Name="CollapseButton" Content="Collapse" Click="HideTray"/></WrapPanel>
   <WrapPanel><Button x:Name="EndSessionButton" Content="End session" Command="{Binding EndCommand}" IsEnabled="{Binding HasOpenSession}"/><Button x:Name="QuitButton" Content="Quit Clips" Command="{Binding QuitCommand}"/></WrapPanel>
  </StackPanel>
  <ScrollViewer x:Name="RecentScroll" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Recent}"><ItemsControl.ItemTemplate><DataTemplate><Border CornerRadius="8" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Caption}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap" MaxHeight="76" TextTrimming="CharacterEllipsis" Visibility="{Binding IsText,Converter={StaticResource BoolVisibility}}"/><Image Source="{Binding PreviewImage}" MaxHeight="90" Stretch="Uniform" Visibility="{Binding IsImage,Converter={StaticResource BoolVisibility}}"/><Expander Header="Add note" Margin="0,8,0,0" Expanded="NoteExpanded"><StackPanel><TextBox Text="{Binding Note,UpdateSourceTrigger=PropertyChanged}" MaxLength="10000" AcceptsReturn="True" MinHeight="50" MaxHeight="160" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" AutomationProperties.Name="Attached capture note"/><Button Content="Save note" Command="{Binding SaveNoteCommand}"/><TextBlock Text="{Binding NoteStatus}" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
 </DockPanel>
</Window>
