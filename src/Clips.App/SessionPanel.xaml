<Window x:Class="Clips.App.SessionPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clips companion" Width="324" Height="190" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" AllowsTransparency="True" Background="Transparent">
 <Border Margin="8" Padding="14,10" CornerRadius="16" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
  <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12"/></Border.Effect>
  <StackPanel>
   <Grid MouseLeftButtonDown="DragPanel" Cursor="SizeAll" Background="Transparent" ToolTip="Drag to move">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding TrayLabel}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{Binding TrayColor}" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBlock Text="{Binding TrayState}" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel>
   </Grid>
   <DockPanel Margin="0,7,0,0" DataContext="{Binding Feedback}">
    <Button x:Name="FeedbackButton" DockPanel.Dock="Right" Content="{Binding ActionLabel}" Command="{Binding ActionCommand}" Visibility="{Binding HasAction,Converter={StaticResource BoolVisibility}}" Padding="8,3" Margin="6,0,0,0" FontSize="11"/>
    <TextBlock Text="{Binding Message}" ToolTip="{Binding Message}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
   </DockPanel>
   <Grid Margin="0,10,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="RecentButton" Content="Recent captures" Click="ShowRecent" Padding="8,8" Margin="0,0,5,0" FontSize="12" AutomationProperties.Name="Recent captures" ToolTip="Review your latest captures and add notes"/>
    <Button x:Name="NotebookButton" Grid.Column="1" Content="Open notebook" Click="ShowNotebook" Padding="8,8" Margin="5,0,0,0" FontSize="12" AutomationProperties.Name="Open notebook" ToolTip="Open the main Clips window"/>
   </Grid>
   <Grid Margin="0,7,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button x:Name="EndSessionButton" Content="End session" Command="{Binding EndCommand}" IsEnabled="{Binding HasOpenSession}" Padding="8,6" Margin="0,0,5,0" FontSize="11" ToolTip="Stop capturing and keep this panel and your notes"/>
    <Button x:Name="QuitButton" Grid.Column="1" Content="Quit Clips" Command="{Binding QuitCommand}" Padding="8,6" Margin="5,0,0,0" FontSize="11" ToolTip="Close Clips completely"/>
   </Grid>
  </StackPanel>
 </Border>
</Window>
